{
  "manifest_version": 3,
  "name": "SOOP Same-Window Navigation",
  "version": "1.0.0",
  "description": "Keeps SOOP links in the dedicated app window.",
  "content_scripts": [
    {
      "matches": [
        "*://*.sooplive.com/*",
        "*://*.sooplive.co.kr/*"
      ],
      "js": ["same-window.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
